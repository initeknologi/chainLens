# Embedded Postgres is started automatically by `pnpm dev` when DATABASE_URL is empty.
# Use this when you run PostgreSQL yourself (Docker Compose or hosted Postgres).
DATABASE_URL=postgresql://chainlens:chainlens@127.0.0.1:5432/chainlens?sslmode=disable

# Optional. When set, the worker consumes BullMQ jobs. Without it, the API indexes inline.
REDIS_URL=redis://127.0.0.1:6379

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional. ChainLens explains from retrieved evidence even when this is empty.
# The model is not allowed to invent amounts, hashes, or a security verdict.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional public HTTPS RPC overrides. Private hosts are rejected.
ETH_RPC_URL=https://ethereum.publicnode.com
BSC_RPC_URL=https://bsc.publicnode.com
POLYGON_RPC_URL=https://polygon-bor.publicnode.com
BASE_RPC_URL=https://base.publicnode.com
